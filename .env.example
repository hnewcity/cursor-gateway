# Copy to .env; environment variables take precedence.
CURSOR_DIRECT_HOST=127.0.0.1
CURSOR_DIRECT_PORT=8790
# CURSOR_DIRECT_API_KEY=sk-your-secret
CURSOR_DIRECT_AUTH_FILE=./accounts.json
CURSOR_DIRECT_BASE_URL=https://api2.cursor.sh
CURSOR_DIRECT_CLIENT_VERSION=cli-2026.08.11-e8db854
CURSOR_DIRECT_TIMEOUT_MS=300000
# SOCKS5 supports optional username/password. DNS is resolved by the proxy.
# CURSOR_DIRECT_PROXY_URL=socks5://127.0.0.1:1080
# Leave empty to expose models without the cursor- prefix.
CURSOR_DIRECT_MODEL_PREFIX=
# '*' allows all native tools to be advertised. Only caller MCP tools execute here.
CURSOR_ALLOWED_NATIVE_TOOLS=mcp_tool_call
CURSOR_DIRECT_SYSTEM_AS_HISTORY=true
# Experimental: replay recent visible reasoning summaries as historical assistant notes.
CURSOR_DIRECT_REPLAY_REASONING=true
CURSOR_DIRECT_REASONING_REPLAY_MAX_CHARS=12000
# Format correction attempts within one Cursor run, before dispatching client tools.
CURSOR_DIRECT_TOOL_INPUT_RETRIES=1
CURSOR_DIRECT_REUSE_SESSIONS=true
CURSOR_DIRECT_SESSION_KEEPALIVE_SECONDS=300
CURSOR_DIRECT_SESSION_MAX_ENTRIES=8
CURSOR_DIRECT_CONTINUATION_PROMPT="Continue, using the tool results above."
# Log request summaries, IDs and durations; errors remain logged when false.
# Request bodies and authentication headers are not logged.
CURSOR_DIRECT_LOG_REQUESTS=true
CURSOR_DIRECT_MAX_BODY_BYTES=67108864
# Responses history is process-local; restart clears it. store=false skips storage.
CURSOR_DIRECT_RESPONSE_CACHE_TTL=3600
CURSOR_DIRECT_RESPONSE_CACHE_ENTRIES=256
CURSOR_DIRECT_RESPONSE_CACHE_BYTES=134217728
# Persist this key with the account directory to replay compacted history after restart.
# CURSOR_DIRECT_COMPACTION_KEY_FILE=./data/compaction.key
